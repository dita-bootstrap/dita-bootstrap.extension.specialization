<?xml version="1.0" encoding="UTF-8"?>
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog" prefer="public">
  <public
    publicId="-//Infotexture//DTD DITA Bootstrap Extension Topic//EN"
    uri="base/bootstrap-ext-topic.dtd"
  />
  <public
    publicId="-//Infotexture//ENTITIES DITA Bootstrap Extension Domain//EN"
    uri="base/bootstrapExtDomain.ent"
  />
  <public
    publicId="-//Infotexture//ELEMENTS DITA Bootstrap Extension Domain//EN"
    uri="base/bootstrapExtDomain.mod"
  />

  <!-- Explicitly chain the core catalog if global resolution fails -->
  <nextCatalog
    catalog="plugin:org.dita-bootstrap.specialization:dtd/catalog.xml"
  />

  <!-- Core Mappings using plugin: URIs -->

  <public
    publicId="-//Infotexture//ENTITIES DITA Bootstrap Domain//EN"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/bootstrapDomain.ent"
  />
  <public
    publicId="-//Infotexture//ELEMENTS DITA Bootstrap Domain//EN"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/bootstrapDomain.mod"
  />
  <public
    publicId="-//Infotexture//ELEMENTS DITA Bootstrap Common Overrides//EN"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/commonElements.mod"
  />

  <system
    systemId="bootstrap-ext-topic.dtd"
    uri="base/bootstrap-ext-topic.dtd"
  />
  <system systemId="bootstrapExtDomain.ent" uri="base/bootstrapExtDomain.ent"/>
  <system systemId="bootstrapExtDomain.mod" uri="base/bootstrapExtDomain.mod"/>

  <!-- Core System mappings using Suffix-matching (most robust for CI) -->
  <systemSuffix
    systemIdSuffix="bootstrapDomain.ent"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/bootstrapDomain.ent"
  />
  <systemSuffix
    systemIdSuffix="bootstrapDomain.mod"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/bootstrapDomain.mod"
  />
  <systemSuffix
    systemIdSuffix="commonElements.mod"
    uri="plugin:org.dita-bootstrap.specialization/dtd/base/commonElements.mod"
  />
</catalog>
